# FitBite Pal - Docker 环境变量配置
# 复制此文件为 .env 并修改配置值
# 用于 docker-compose.yml

# ========================================
# MySQL 数据库配置
# ========================================
MYSQL_ROOT_PASSWORD=
MYSQL_USER=fitbite_app
MYSQL_PASSWORD=
MYSQL_DATABASE=fitbitepal
MYSQL_PORT=3306

# ========================================
# Redis 配置
# ========================================
REDIS_PORT=6379

# ========================================
# 后端服务配置
# ========================================
FITBITE_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080

# JWT 密钥 (必须修改为安全的随机字符串，至少256位)
# Generate with openssl rand -hex 32
JWT_SECRET=
# Set only when creating the initial admin account
FITBITE_ADMIN_EMAIL=
FITBITE_ADMIN_PASSWORD=
JWT_EXPIRATION=86400000

# ========================================
# 邮件服务配置
# ========================================
# Hosted SMTP only; the Mailpit overlay uses a private local inbox.
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ========================================
# AI 服务配置 (可选)
# ========================================
AI_ENABLED=false
AI_PROVIDER=ark
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ARK_API_KEY=
ARK_MODEL=doubao-seed-2.0-pro
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_ENABLED=true

# ========================================
# 跨域配置 (生产环境)
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

